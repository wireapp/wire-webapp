# Reference: https://help.github.com/articles/dealing-with-line-endings/
# enforce LF line endings
* text eol=lf
# Store binary assets in Git LFS.
*.bin filter=lfs diff=lfs merge=lfs -text
# Denote all files that are truly binary and should not be modified.
*.eot binary
*.jar binary
*.jpg binary
*.mp3 binary
*.mp4 binary
*.otf binary
*.png binary
*.svg binary
*.ttf binary
*.woff binary
*.woff2 binary
# Machine Learning Models
*.tflite binary
*.onnx binary
*.pb binary
*.pt binary

# Self-hosted note taker weights are hydrated during checkout and served as assets.
apps/webapp/assets/noteTakerModels/**/*.onnx filter=lfs diff=lfs merge=lfs -text

# Preserve upstream metadata while keeping generated model data out of code review.
apps/webapp/assets/noteTakerModels/** linguist-vendored linguist-generated
