{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "paths": {
      "@sindresorhus/is": ["node_modules/@sindresorhus/is/distribution/index.d.ts"]
    },
    "target": "es2024",
    "lib": ["ES2024"],
    "types": ["node"],
    "rootDir": ".",
    "allowImportingTsExtensions": true
  },
  "include": ["bin/**/*.ts"],
  "exclude": ["node_modules", "dist", "tmp", "bin/**/*.test.ts", "bin/jest.config.js"]
}
