{
  "compileOnSave": false,
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "downlevelIteration": true,
    "alwaysStrict": true,
    "strict": true,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    // Temporary compatibility mapping: legacy CommonJS projects cannot resolve
    // the ESM-only package's declaration through package exports. Remove this
    // when those projects are migrated deliberately to modern resolution.
    "paths": {
      "@sindresorhus/is": ["node_modules/@sindresorhus/is/distribution/index.d.ts"]
    },
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "target": "es2024",
    "module": "esnext",
    "lib": ["ES2024", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": "."
  },
  "exclude": ["node_modules", "tmp"]
}
