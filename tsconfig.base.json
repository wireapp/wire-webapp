{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "alwaysStrict": true,
    "strict": true,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    // Compatibility mappings for projects whose package declarations need explicit entrypoints.
    "paths": {
      "@sindresorhus/is": ["./node_modules/@sindresorhus/is/distribution/index.d.ts"],
      "ts-extras": ["./node_modules/ts-extras/distribution/index.d.ts"]
    },
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "target": "es2024",
    "module": "esnext",
    "lib": ["ES2024", "dom"],
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "tmp"]
}
