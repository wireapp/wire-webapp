{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2024",
    "lib": ["ES2024"],
    "types": ["node", "jest"],
    "rootDir": ".",
    "allowImportingTsExtensions": true
  },
  "include": ["tools/**/*.ts", "tools/**/*.mts"],
  "exclude": [
    "node_modules",
    "dist",
    "tmp",
    "tools/release-appearance",
    "tools/release-cli"
  ]
}
