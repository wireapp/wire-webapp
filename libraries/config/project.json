{
  "name": "config-lib",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf lib && tsc --build --clean",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/lib", "{workspaceRoot}/target/buildcache/config-build.tsbuildinfo"],
      "dependsOn": ["clean"],
      "options": {
        "command": "tsc",
        "cwd": "{projectRoot}"
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --watch",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": ["type:lib", "scope:config"]
}
