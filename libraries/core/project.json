{
  "name": "core-lib",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf .tmp lib",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/lib"],
      "dependsOn": ["^build", "clean"],
      "options": {
        "command": "tsc",
        "cwd": "{projectRoot}"
      }
    },
    "dist": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "echo 'Build complete'"
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --watch",
        "cwd": "{projectRoot}"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project {projectRoot}/tsconfig.type-check.json --noEmit"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["dist"],
      "options": {
        "command": "node index.js",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": ["type:lib", "scope:core"]
}
