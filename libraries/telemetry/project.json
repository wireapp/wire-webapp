{
  "name": "telemetry-lib",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx rimraf lib && tsc --build --clean tsconfig.json tsconfig.commonjs.json",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/lib", "{workspaceRoot}/target/buildcache/telemetry-esm-build.tsbuildinfo", "{workspaceRoot}/target/buildcache/telemetry-commonjs-build.tsbuildinfo"],
      "dependsOn": ["clean"],
      "options": {
        "command": "node bin/copyAssets.mts && tsc --build tsconfig.json tsconfig.commonjs.json",
        "cwd": "{projectRoot}"
      }
    },
    "dist": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "echo 'Build complete'"
      }
    }
  },
  "tags": ["type:lib", "scope:telemetry"]
}
