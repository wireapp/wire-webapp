{
  "name": "telemetry-lib",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "targets": {
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx rimraf lib",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/lib"],
      "dependsOn": ["clean"],
      "options": {
        "command": "node bin/copyAssets.mts && tsc --build tsconfig.json tsconfig.commonjs.json",
        "cwd": "{projectRoot}"
      }
    },
    "dist": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "echo 'Build complete'"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "dependsOn": ["^build", "build", "config-lib:build"],
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js", "{workspaceRoot}/apps/server/bin/copy_server_assets.js", "{workspaceRoot}/apps/server/package.json"],
      "outputs": ["{workspaceRoot}/coverage/libraries/telemetry"],
      "options": {
        "jestConfig": "{projectRoot}/jest.config.js",
        "passWithNoTests": false
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true,
          "coverageReporters": ["lcov", "text"]
        }
      }
    },
    "test:coverage": {
      "executor": "@nx/jest:jest",
      "dependsOn": ["^build", "build", "config-lib:build"],
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js", "{workspaceRoot}/apps/server/bin/copy_server_assets.js", "{workspaceRoot}/apps/server/package.json"],
      "outputs": ["{workspaceRoot}/coverage/libraries/telemetry"],
      "options": {
        "jestConfig": "{projectRoot}/jest.config.js",
        "passWithNoTests": false,
        "coverage": true
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/lib"],
      "options": {
        "command": "node bin/copyAssets.mts && tsc --build tsconfig.json tsconfig.commonjs.json --watch --preserveWatchOutput",
        "cwd": "{projectRoot}"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project {projectRoot}/tsconfig.json --noEmit && tsc --project {projectRoot}/tsconfig.commonjs.json --noEmit && tsc --project {projectRoot}/tsconfig.type-check.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --config eslint.config.mjs --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/telemetry --ext .js,.jsx,.ts,.tsx,.cjs,.mjs,.mts {projectRoot}"
      }
    }
  },
  "tags": ["type:lib", "scope:telemetry"]
}
