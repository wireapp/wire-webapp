{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "esModuleInterop": true,
    "noImplicitAny": true,
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "outDir": "lib",
    "declaration": true,
    "incremental": true,
    "tsBuildInfoFile": "../../target/buildcache/telemetry-esm-build.tsbuildinfo",
    "target": "esnext",
    "rootDir": "src"
  },
  "exclude": [
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**/*"
  ],
  "include": [
    "src/**/*"
  ]
}
