  "name": "wire-webapp",
  "prettier": "@wireapp/prettier-config",
  "private": true,
  "workspaces": [
    "apps/*",
    "libraries/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wireapp/wire-webapp.git"
  },
  "scripts": {
    "build:libs": "npx just build-libraries",
    "bundle:dev": "nx run server:assemble-webapp-development",
    "bundle:prod": "nx run server:assemble-webapp",
    "bundle:prod:public": "nx run server:assemble-webapp-public",
    "clean:jest": "nx reset && nx run workspace-tools:clean-jest",
    "clean:dependencies": "find . -name node_modules -type d -prune -exec rm -rf '{}' +",
    "dev": "nx serve server",
    "dev:packages": "nx run-many -t watch --projects=tag:type:lib",
    "docker": "nx run workspace-tools:docker",
    "postinstall": "patch-package && nx run webapp:configure",
    "ci:install": "npm clean-install --ignore-scripts && npm exec -- patch-package --error-on-fail",
    "release": "nx release",
    "release:dry-run": "nx release --dry-run",
    "release:version": "nx release version",
    "release:publish": "nx release publish",
    "start": "nx serve server",
    "start:watch": "ts-node --project ./tsconfig.tools.json tools/development/startWatch.ts",
    "e2e-test": "nx e2e webapp",
    "e2e-ui": "nx e2e webapp --ui",
    "build:prod": "nx run server:package",
    "build:prod:public": "nx run server:package-public",
    "verify:bundle:prod:public": "node tools/buildArtifact/verifyPublicProductionBundle.ts"
  },
  "overrides": {
    "@emotion/eslint-plugin": {
      "eslint": "^8.0.0 || ^9.0.0"
    },
    "license-checker": "25.0.1",
    "stylelint-order": {
      "stylelint": "^14.0.0 || ^15.0.0 || ^16.0.1 || ^17.0.0"
    },
