{
  "name": "webapp",
  "$schema": "{projectRoot}/node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{projectRoot}/dist/internal"],
      "dependsOn": ["^build", "server:generate-build-metadata"],
      "inputs": ["production", "webappBuildMetadata", "{workspaceRoot}/apps/server/build/metadata/version.json"],
      "options": {
        "command": "WIRE_WEBAPP_BUILD_METADATA_PATH=apps/server/build/metadata/version.json WIRE_WEBAPP_BUILD_OUTPUT_PATH=apps/webapp/dist/internal npm run build:prod",
        "cwd": "{projectRoot}"
      }
    },
    "build-development": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{projectRoot}/dist/development"],
      "dependsOn": ["^build", "server:generate-build-metadata"],
      "inputs": ["production", "webappBuildMetadata", "{workspaceRoot}/apps/server/build/metadata/version.json"],
      "options": {
        "command": "WIRE_WEBAPP_BUILD_METADATA_PATH=apps/server/build/metadata/version.json WIRE_WEBAPP_BUILD_OUTPUT_PATH=apps/webapp/dist/development npm run build:dev",
        "cwd": "{projectRoot}"
      }
    },
    "build-production-public": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{projectRoot}/dist/public"],
      "dependsOn": ["^build", "server:generate-build-metadata"],
      "inputs": ["production", "webappBuildMetadata", "{workspaceRoot}/apps/server/build/metadata/version.json"],
      "options": {
        "command": "WIRE_WEBAPP_BUILD_METADATA_PATH=apps/server/build/metadata/version.json WIRE_WEBAPP_BUILD_OUTPUT_PATH=apps/webapp/dist/public npm run build:prod:public",
        "cwd": "{projectRoot}"
      }
    },
    "watch-deps": {
      "continuous": true,
      "dependsOn": ["^watch"],
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Watching upstream library dependencies' && tail -f /dev/null",
        "cwd": "{projectRoot}"
      }
    },
    "build-libs": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'All libraries built'",
        "cwd": "{projectRoot}"
      }
    },
    "watch-deps-dynamic": {
      "continuous": true,
      "dependsOn": ["build-libs"],
      "executor": "nx:run-commands",
      "options": {
        "command": "[ -n \"$WATCH_LIBS\" ] && nx run-many -t watch --projects=$WATCH_LIBS || tail -f /dev/null",
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "echo 'Use npm run start from the root to run the Rspack development server'"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "playwright test --config {projectRoot}/playwright.config.ts"
      }
    },
    "stylelint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx just stylesheet-lint"
      }
    },
    "configure": {
      "executor": "nx:run-commands",
      "dependsOn": ["copy-config-lib:build"],
      "options": {
        "command": "node ../../libraries/copy-config/lib/cli.js ./.copyconfigrc.js && ts-node ./bin/generate_react_icons.ts && tsc --project ./tsconfig.generated-icons.json --noEmit",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": ["type:app", "scope:frontend"]
}
