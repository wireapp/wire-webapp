{
  "extends": "./tsconfig.type-check.json",
  "compilerOptions": {
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "tsBuildInfoFile": "../../target/buildcache/webapp-api-client-type-check.tsbuildinfo"
  },
  "include": ["src/script/apiClient/**/*.ts", "src/script/apiClient/**/*.d.ts"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
