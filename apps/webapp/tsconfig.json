{
  "extends": "../../tsconfig.base.json",
  "references": [{"path": "../../libraries/config"}],
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "module": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "noEmitOnError": true,
    "outDir": "../../dist/apps/webapp",
    "paths": {
      "@sindresorhus/is": ["../../node_modules/@sindresorhus/is/distribution/index.d.ts"],
    },
    "rootDirs": ["src"],
    "target": "ESNext",
    "strict": true,
    "strictPropertyInitialization": false,
    "strictFunctionTypes": false
  },
  "types": ["@types/wicg-file-system-access", "jest", "@testing-library/jest-dom"],
  "include": ["bin/**/*", "src/**/*", "test/**/*"],
  "exclude": ["node_modules", "../server/", "src/worker/"]
}
