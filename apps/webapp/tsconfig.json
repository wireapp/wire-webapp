{
  "extends": "../../tsconfig.base.json",
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "noEmitOnError": true,
    "outDir": "../../dist/apps/webapp",
    "paths": {
      "@enormora/clock/clock": ["../../node_modules/@enormora/clock/clock.entry-point.d.ts"],
      "@enormora/objectory": ["../../node_modules/@enormora/objectory/main.d.ts"],
      "@sindresorhus/is": ["../../node_modules/@sindresorhus/is/distribution/index.d.ts"],
      "ts-extras": ["../../node_modules/ts-extras/distribution/index.d.ts"],
    },
    // Preserve the existing declaration lookup for package-private type imports.
    "resolvePackageJsonExports": false,
    "resolvePackageJsonImports": false,
    "target": "ESNext",
    "strict": true,
    "strictPropertyInitialization": false,
    "strictFunctionTypes": false
  },
  "types": ["@types/wicg-file-system-access", "jest", "@testing-library/jest-dom"],
  "include": ["bin/**/*", "src/**/*", "test/**/*"],
  "exclude": ["node_modules", "../server/", "src/worker/"]
}
