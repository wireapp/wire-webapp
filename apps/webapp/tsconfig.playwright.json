{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    // @wireapp/* packages use their workspace package exports; only local E2E aliases that fail
    // package resolution are retained here.
    "paths": {
      // E2E startup feature toggles import the production definitions and query-string updater.
      "src/*": ["./src/*"],
    }
  },
  "include": [
    "playwright.config.ts",
    "playwright.rspack.config.ts",
    "test/e2e_tests/playwright-globals.d.ts",
    "test/e2e_tests/**/*.ts",
    "test/e2e_tests/**/*.tsx",
    "test/rspack-smoke/browser-smoke.ts",
    "test/rspack-smoke/rspackSmokeAssetPathResolver.ts",
    "test/rspack-smoke/server.ts"
  ],
  "exclude": ["node_modules"]
}
