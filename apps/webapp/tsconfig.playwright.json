{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    // Prevent inherited path mappings from affecting Playwright resolution.
    "paths": {}
},
  "include": [
    "playwright.config.ts",
    "playwright.rspack.config.ts",
    "test/e2e_tests/playwright-globals.d.ts",
    "test/e2e_tests/**/*.ts",
    "test/e2e_tests/**/*.tsx",
    "test/rspack-smoke/browser-smoke.ts",
    "test/rspack-smoke/rspackSmokeAssetPathResolver.ts",
    "test/rspack-smoke/server.ts"
  ],
  "exclude": ["node_modules"]
}
