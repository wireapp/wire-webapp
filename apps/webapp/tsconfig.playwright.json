{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    // Keep the root's legacy declaration path mapping from affecting Playwright runtime resolution.
    "paths": {}
  },
  "include": [
    "playwright.config.ts",
    "playwright.rspack.config.ts",
    "test/e2eTests/playwrightGlobals.d.ts",
    "test/e2eTests/**/*.ts",
    "test/e2eTests/**/*.tsx",
    "test/rspackSmoke/browserSmoke.ts",
    "test/rspackSmoke/originPrivateFileSystemBrowserSmoke.ts",
    "test/rspackSmoke/rspackSmokeAssetPathResolver.ts",
    "test/rspackSmoke/server.ts"
  ],
  "exclude": ["node_modules"]
}
