{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    // @wireapp/* packages use their workspace package exports; only local E2E aliases that fail
    // package resolution are retained here.
    "paths": {
      // Calling specs and audio.util.ts import Repositories/audio/audioType.
      "Repositories/*": ["./src/script/repositories/*"],
      // localization.spec.ts imports I18n/de-DE.json and I18n/en-US.json.
      "I18n/*": ["./src/i18n/*"]
    }
  },
  "include": ["playwright.config.ts", "test/e2e_tests/playwright-globals.d.ts", "test/e2e_tests/**/*.ts", "test/e2e_tests/**/*.tsx"],
  "exclude": ["node_modules"]
}
