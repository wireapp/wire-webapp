<!DOCTYPE html>
<!-- Wire, Copyright (C) 2024 Wire Swiss GmbH -->
<!--! <%= VERSION %> -->
<html id="wire-main-app">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="geoip" content="{{ country }}"/>
    <link href="/image/favicon.ico?<%= ASSET_VERSION %>" type="image/x-icon" rel="shortcut icon" sizes="48x48"/>
    <link href="/image/meta/wire-icon-256.png?<%= ASSET_VERSION %>" rel="icon" sizes="256x256" type="image/png"/>
    <link href="/image/meta/wire-icon-128.png?<%= ASSET_VERSION %>" rel="icon" sizes="128x128" type="image/png"/>
    <link href="/image/meta/wire-icon-64.png?<%= ASSET_VERSION %>" rel="icon" sizes="64x64" type="image/png"/>

    <meta property="og:title" content="<%= OPEN_GRAPH_TITLE %>"/>
    <meta property="og:description" name="description" content="<%= OPEN_GRAPH_DESCRIPTION %>"/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="<%= APP_BASE %>"/>
    <meta property="og:image" content="<%= OPEN_GRAPH_IMAGE_URL %>"/>

    <title><%= BRAND_NAME %></title>

    <style>
      html {
        line-height: 1.15;
        font-size: 16px;
        -webkit-text-size-adjust: 100%;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
        font-weight: 400;
        line-height: 1.5;
        margin: 0;
      }

      header {
        -webkit-box-align: center;
        align-items: center;
        display: flex;
        -webkit-box-pack: justify;
        justify-content: space-between;
      }

      main {
        display: flex;
        flex-direction: column;
        -webkit-box-flex: 1;
        padding: 0 16px;
      }

      footer {
        height: 30px;
        justify-content: flex-end;
        margin: 0 0 18px 8px;
      }

      span {
        display: inline;
        font-size: 12px;
        font-weight: 400;
        text-align: left;
        text-transform: none;
      }

      h2 {
        display: block;
        font-size: 1.25rem;
        text-align: left;
        text-transform: none;
        line-height: 1.75rem;
        font-weight: 500;
        margin-bottom: 10px;
        margin-top: 0;
      }

      h3 {
        display: block;
        font-size: 1rem;
        font-weight: 500;
        text-align: left;
        text-transform: none;
        margin-bottom: 10px;
      }

      a {
        color: black;
        display: inline;
        font-size: 0.6875rem;
        font-weight: 600;
        text-align: left;
        cursor: pointer;
        transition: all 0.24s;
      }

      strong {
        font-weight: 800;
      }

      .content {
        display: flex;
        flex-direction: column;
        -webkit-box-flex: 1;
        flex-grow: 1;
        padding: 0 16px;
      }

      .textContent {
        margin: auto;
        position: relative;
        text-align: left;
        width: 100%;

        @media (min-width: 920px) {
          padding: 0;
          width: 888px;
        }
      }
    </style>
</head>


<body>
<div style="box-sizing: border-box;">
    <div style="display: flex; height: 100%; min-height: 100vh;">
        <div style="display: flex; flex-direction: column; min-height: 100vh; width: 100%;">
            <div class="content">
                <header style="height: 40px; margin-left: 8px; margin-top: 20px;">
                    <img
                        src="/image/icon/logo-full-icon.svg?<%= ASSET_VERSION %>"
                        alt="<%= BRAND_NAME %>"
                        style="height: 23px; width: auto; overflow: visible;"
                    />
                </header>
                <main style="flex: 1 1 0; padding-left: 8px; width: 100%;">
                    <div class="textContent">
                        <h2 data-uie-name="element-unsupported-headline"><%= BRAND_NAME %> doesn't support this browser</h2>
                        <h3 data-uie-name="element-unsupported-general">
                            To use <%= BRAND_NAME %> for web, download the latest version of <strong>Google Chrome, Mozilla Firefox</strong>,
                            or <strong>Microsoft Edge</strong>.
                        </h3>
                        <h3 data-uie-name="element-unsupported-settings">

                        </h3>
                        <h3 data-uie-name="element-unsupported-support-link">
                            <a rel="noopener noreferrer" target="_blank" style="font-size: 1rem;"
                               href="<%= SUPPORT_INDEX %>"
                            >Learn more about <%= BRAND_NAME %>'s system requirements</a>
                        </h3>
                    </div>
                </main>

                <footer>
                    <a style="text-transform: uppercase; text-decoration: none;" rel="noopener noreferrer"
                       href="<%= WEBSITE_BASE %>">
                        <%= WEBSITE_LABEL %>
                    </a>
                    <span> · © <%= BRAND_NAME %></span>
                </footer>
            </div>
        </div>
    </div>
</div>
</body>
</html>
