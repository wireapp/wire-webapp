{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@sindresorhus/is": ["../../node_modules/@sindresorhus/is/distribution/index.d.ts"],
      "@enormora/clock/clock": ["../../node_modules/@enormora/clock/clock.entry-point.d.ts"],
      "Components/*": ["./src/script/components/*"],
      "Repositories/*": ["./src/script/repositories/*"],
      "Util/*": ["./src/script/util/*"],
    }
  },
  "exclude": [
    "node_modules",
    "../server/",
    "src/worker/",
    "src/**/*.mocks.ts",
    "src/**/test/**",
    "src/**/testSupport/**",
    "test/unit_tests/**",
    "test/helper/**",
    "**/*.test.*"
  ]
}
