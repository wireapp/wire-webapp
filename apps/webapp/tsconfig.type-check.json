{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "noUncheckedIndexedAccess": false,
    "incremental": true,
    "tsBuildInfoFile": "../../target/buildcache/webapp-type-check.tsbuildinfo",
    "paths": {
      "@sindresorhus/is": ["../../node_modules/@sindresorhus/is/distribution/index.d.ts"],
      "@enormora/objectory": ["../../node_modules/@enormora/objectory/main.d.ts"],
      "@enormora/clock/clock": ["../../node_modules/@enormora/clock/clock.entry-point.d.ts"],
      "Components/*": ["./src/script/components/*"],
      "Repositories/*": ["./src/script/repositories/*"],
      "Util/*": ["./src/script/util/*"],
    }
  },
  "exclude": ["node_modules", "../server/", "src/worker/"]
}
